{
  "name": "passkeys-kit",
  "main": "dist/index.mjs",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "assets": { "directory": "../site", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "AUTH", "class_name": "AuthDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AuthDO"] }],
  "observability": { "enabled": false }
}
